{
  "name": "@hexafy/aws-lambda-example",
  "private": true,
  "scripts": {
    "build": "bun --bun esbuild 'src/lambda/*.ts' --platform=node --format=cjs --bundle --external:aws-sdk --external:@hexafy/aws-lambda-example --main-fields=main:default,module --target=node22 --outdir=dist",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "db:init": "bun src/scripts/init-db.ts",
    "dev": "bun run db:init && docker run -d -p 4566:4566 -p 3000:3000 --name localstack localstack/localstack:3.0",
    "dev:stop": "docker stop localstack"
  },
  "dependencies": {
    "@hexafy/aws-lambda": "1.0.0",
    "@hexafy/core": "1.0.0",
    "nanoid": "6.0.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
