{
  "name": "hexafy",
  "private": true,
  "author": "Philipp Teßner-Müller",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "bun lint --fix",
    "changeset": "changeset",
    "clean": "git clean -xdf node_modules && bun --filter '*' clean",
    "format": "bun fmt",
    "test": "bun test",
    "typecheck": "bun --filter '*' --filter '!@hexafy/typescript-config' --filter '!@hexafy/aws-lambda-example' --filter '!@hexafy/nestjs-example' --filter '!@hexafy/example-domain' typecheck",
    "build": "bun --filter '*' --filter '!@hexafy/typescript-config' --filter '!@hexafy/aws-lambda-example' --filter '!@hexafy/nestjs-example' --filter '!@hexafy/example-domain' build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.4",
    "husky": "^9.1.7",
    "publint": "0.3.25",
    "tsdown": "0.23.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
