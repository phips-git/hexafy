{
  "name": "hexafy",
  "private": true,
  "author": "Philipp Teßner-Müller",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "~26",
      "typescript": "~7"
    }
  },
  "scripts": {
    "lint": "bun lint --fix --max-warnings 0",
    "changeset": "changeset",
    "clean": "git clean -xdf node_modules && bun --filter '*' clean",
    "format": "bun fmt",
    "publish": "bun publish --recursive",
    "publish:ci": "changeset publish",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.4",
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
