{
  "name": "hexagonal-architecture-typescript-template",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7"
    }
  },
  "scripts": {
    "clean": "git clean -xdf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" && sort-package-json \"**/package.json\"",
    "lint": "bun lint --workspaces --if-present",
    "test": "bun test --workspaces --if-present",
    "typecheck": "bun typecheck --workspaces --if-present",
    "publish": "bun publish --recursive"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sort-package-json": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
