{
  "name": "hexafy",
  "private": true,
  "author": "Philipp Teßner-Müller",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7"
    }
  },
  "scripts": {
    "changeset": "changeset",
    "clean": "git clean -xdf node_modules && bun --filter '*' clean",
    "format": "bun fmt",
    "lint": "bun --filter '*' lint",
    "publish": "bun publish --recursive",
    "publish:ci": "changeset publish",
    "test": "bun test --workspaces --if-present",
    "typecheck": "bun --filter '*' typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
