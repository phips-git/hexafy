{
  "name": "@hex/aws-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda adapters and helpers for hexagonal architecture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hexagonal-architecture",
    "aws",
    "lambda",
    "api-gateway",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/philippos/hexagonal-architecture-typescript-template"
  },
  "dependencies": {
    "@hex/core": "1.0.0",
    "@types/aws-lambda": "^8.10.147"
  },
  "devDependencies": {
    "typescript": "^7"
  },
  "publishConfig": {
    "access": "public"
  }
}
