{
  "name": "@hexafy/aws-lambda",
  "version": "0.0.0",
  "description": "AWS Lambda adapters and helpers for hexagonal architecture",
  "keywords": [
    "api-gateway",
    "aws",
    "hexagonal-architecture",
    "lambda",
    "typescript"
  ],
  "license": "MIT",
  "author": "Philipp Teßner-Müller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phips-git/hexafy.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@hexafy/core": "workspace:*"
  },
  "devDependencies": {
    "@hexafy/tsdown-config": "workspace:*",
    "@hexafy/typescript-config": "workspace:*",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "^24.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  }
}
