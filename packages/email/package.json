{
  "name": "@hexafy/email",
  "version": "0.0.0",
  "private": false,
  "description": "Email domain and infrastructure for hexafy applications",
  "keywords": [
    "email",
    "hexafy",
    "hexagonal-architecture",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phips-git/hexafy.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./domain": "./src/domain.export.ts",
    "./infrastructure": "./src/infrastructure.export.ts"
  },
  "publishConfig": {
    "exports": {
      "./domain": {
        "types": "./dist/domain.d.mts",
        "import": "./dist/domain.mjs",
        "default": "./dist/domain.mjs"
      },
      "./infrastructure": {
        "types": "./dist/infrastructure.d.mts",
        "import": "./dist/infrastructure.mjs",
        "default": "./dist/infrastructure.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@hexafy/tsdown-config": "workspace:*",
    "@hexafy/typescript-config": "workspace:*",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  }
}
