{
  "name": "@hexafy/core",
  "version": "1.0.0-rc.4",
  "description": "Core hexagonal architecture constructs for TypeScript",
  "keywords": [
    "clean-architecture",
    "ddd",
    "hexagonal-architecture",
    "typescript",
    "use-case"
  ],
  "license": "MIT",
  "author": "Philipp Teßner-Müller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phips-git/hexafy.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./application": "./src/application/index.ts",
    "./domain": "./src/domain/index.ts",
    "./infrastructure": "./src/infrastructure/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./application": {
        "types": "./dist/application.d.mts",
        "import": "./dist/application.mjs",
        "default": "./dist/application.mjs"
      },
      "./domain": {
        "types": "./dist/domain.d.mts",
        "import": "./dist/domain.mjs",
        "default": "./dist/domain.mjs"
      },
      "./infrastructure": {
        "types": "./dist/infrastructure.d.mts",
        "import": "./dist/infrastructure.mjs",
        "default": "./dist/infrastructure.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@hexafy/tsdown-config": "workspace:*",
    "@hexafy/typescript-config": "workspace:*",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  }
}
