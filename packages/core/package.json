{
  "name": "@hexafy/core",
  "version": "1.0.0-rc.7",
  "description": "Hexagonal (ports and adapters) architecture primitives for TypeScript: use cases, domain entities, and infrastructure adapters.",
  "keywords": [
    "clean-architecture",
    "ddd",
    "domain-driven-design",
    "hexagonal-architecture",
    "ports-and-adapters",
    "typescript",
    "use-case",
    "use-case-pattern"
  ],
  "homepage": "https://github.com/phips-git/hexafy/tree/main/packages/core",
  "license": "MIT",
  "author": "Philipp Teßner-Müller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phips-git/hexafy.git"
  },
  "type": "module",
  "exports": {
    "./application": "./src/application/index.ts",
    "./domain": "./src/domain/index.ts",
    "./infrastructure": "./src/infrastructure/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./application": {
        "types": "./dist/application.d.mts",
        "import": "./dist/application.mjs",
        "default": "./dist/application.mjs"
      },
      "./domain": {
        "types": "./dist/domain.d.mts",
        "import": "./dist/domain.mjs",
        "default": "./dist/domain.mjs"
      },
      "./infrastructure": {
        "types": "./dist/infrastructure.d.mts",
        "import": "./dist/infrastructure.mjs",
        "default": "./dist/infrastructure.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@hexafy/tsdown-config": "workspace:*",
    "@hexafy/typescript-config": "workspace:*",
    "typescript": "^7"
  }
}
