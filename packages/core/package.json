{
  "name": "@hex/core",
  "version": "1.0.0",
  "description": "Core hexagonal architecture constructs for TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hexagonal-architecture",
    "ddd",
    "clean-architecture",
    "use-case",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/philippos/hexagonal-architecture-typescript-template"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
