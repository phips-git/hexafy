{
  "name": "@hexafy/core",
  "version": "1.0.0",
  "description": "Core hexagonal architecture constructs for TypeScript",
  "keywords": [
    "clean-architecture",
    "ddd",
    "hexagonal-architecture",
    "typescript",
    "use-case"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phips-git/hexafy"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./application": {
      "types": "./dist/application/index.d.ts",
      "import": "./dist/application/index.js",
      "require": "./dist/application/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js",
      "require": "./dist/domain/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "import": "./dist/infrastructure/index.js",
      "require": "./dist/infrastructure/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  }
}
