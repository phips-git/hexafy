{
  "name": "@hexafy/core",
  "version": "1.0.0",
  "description": "Core hexagonal architecture constructs for TypeScript",
  "keywords": [
    "clean-architecture",
    "ddd",
    "hexagonal-architecture",
    "typescript",
    "use-case"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phips-git/hexafy"
  },
  "exports": {
    "./application": {
      "bun": "./src/application/index.ts",
      "types": "./src/application/index.ts",
      "import": {
        "development": "./src/application/index.ts",
        "production": "./dist/application/index.js"
      },
      "require": "./dist/application/index.js"
    },
    "./domain": {
      "bun": "./src/domain/index.ts",
      "types": "./src/domain/index.ts",
      "import": {
        "development": "./src/domain/index.ts",
        "production": "./dist/domain/index.js"
      },
      "require": "./dist/domain/index.js"
    },
    "./infrastructure": {
      "bun": "./src/infrastructure/index.ts",
      "types": "./src/infrastructure/index.ts",
      "import": {
        "development": "./src/infrastructure/index.ts",
        "production": "./dist/infrastructure/index.js"
      },
      "require": "./dist/infrastructure/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "devDependencies": {
    "@hexafy/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  }
}
