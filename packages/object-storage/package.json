{
  "name": "@hexafy/object-storage",
  "version": "0.0.0",
  "private": false,
  "description": "Object storage domain and infrastructure for hexafy applications",
  "keywords": [
    "aws",
    "hexafy",
    "hexagonal-architecture",
    "s3",
    "storage",
    "typescript"
  ],
  "license": "MIT",
  "author": "Philipp Teßner-Müller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phips-git/hexafy.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./domain": "./src/domain.export.ts",
    "./infrastructure": "./src/infrastructure.export.ts"
  },
  "publishConfig": {
    "exports": {
      "./domain": {
        "types": "./dist/domain.d.mts",
        "import": "./dist/domain.mjs",
        "default": "./dist/domain.mjs"
      },
      "./infrastructure": {
        "types": "./dist/infrastructure.d.mts",
        "import": "./dist/infrastructure.mjs",
        "default": "./dist/infrastructure.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hexafy/core": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hexafy/tsdown-config": "workspace:*",
    "@hexafy/typescript-config": "workspace:*",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=22"
  }
}
