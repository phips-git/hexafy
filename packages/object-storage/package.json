{
  "name": "@hexafy/object-storage",
  "version": "1.0.0",
  "private": false,
  "description": "Object storage domain and infrastructure for hexafy applications",
  "keywords": [
    "aws",
    "hexafy",
    "hexagonal-architecture",
    "s3",
    "storage",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phips-git/hexafy"
  },
  "files": [
    "src/**/*"
  ],
  "exports": {
    "./domain": {
      "types": "./src/domain/index.d.ts",
      "import": "./src/domain/index.js",
      "require": "./src/domain/index.js"
    },
    "./infrastructure": {
      "types": "./src/infrastructure/index.d.ts",
      "import": "./src/infrastructure/index.js",
      "require": "./src/infrastructure/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hexafy/core": "1.0.0"
  },
  "devDependencies": {
    "@hexafy/eslint-config": "*",
    "@hexafy/typescript-config": "*",
    "@types/node": "^22.15.0"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  }
}
