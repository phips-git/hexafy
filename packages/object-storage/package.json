{
  "name": "@hexafy/object-storage",
  "version": "1.0.0",
  "private": false,
  "description": "Object storage domain and infrastructure for hexafy applications",
  "keywords": [
    "aws",
    "hexafy",
    "hexagonal-architecture",
    "s3",
    "storage",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phips-git/hexafy"
  },
  "files": [
    "src/**/*"
  ],
  "exports": {
    "./domain": {
      "bun": "./src/domain/index.ts",
      "types": "./src/domain/index.ts",
      "import": {
        "development": "./src/domain/index.ts",
        "production": "./dist/domain/index.js"
      },
      "require": "./dist/domain/index.js"
    },
    "./infrastructure": {
      "bun": "./src/infrastructure/index.ts",
      "types": "./src/infrastructure/index.ts",
      "import": {
        "development": "./src/infrastructure/index.ts",
        "production": "./dist/infrastructure/index.js"
      },
      "require": "./dist/infrastructure/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist && git clean -xdf node_modules",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hexafy/core": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hexafy/typescript-config": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=22"
  }
}
