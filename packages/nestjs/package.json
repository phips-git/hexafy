{
  "name": "@hexafy/nestjs",
  "version": "1.0.0",
  "description": "NestJS adapters and helpers for hexagonal architecture",
  "keywords": [
    "hexagonal-architecture",
    "nestjs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phips-git/hexafy"
  },
  "files": [
    "dist/**/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hexafy/core": "1.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  }
}
